{
  "name": "@oddedd/soom-3d-loader",
  "version": "0.1.1",
  "description": "Minimal 3D loading animations for the web: dot and WebGL loaders in one custom element.",
  "license": "MIT",
  "author": "Odd Edd",
  "homepage": "https://github.com/odd-edd/soom-3d-loader#readme",
  "bugs": {
    "url": "https://github.com/odd-edd/soom-3d-loader/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/react.js"
  ],
  "keywords": [
    "loader",
    "spinner",
    "loading",
    "3d",
    "animation",
    "web-component",
    "react",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odd-edd/soom-3d-loader.git",
    "directory": "packages/web"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
